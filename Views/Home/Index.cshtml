@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Bienvenido a StaffCore RD</h1>
    <p class="lead">Sistema de Gestión de Personal</p>
    <hr class="my-4" />

    @if (User.Identity?.IsAuthenticated == true)
    {
        <p>¿Qué deseas hacer?</p>
        <a asp-controller="Staff" asp-action="Index" class="btn btn-primary btn-lg me-2">
            Ver Personal
        </a>
       
    }
    else
    {
        <p>Por favor, inicia sesión para acceder al sistema.</p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg me-2">
            Iniciar Sesión
        </a>
        <a asp-controller="Account" asp-action="Register" class="btn btn-success btn-lg">
            Registrarse
        </a>
    }
</div>