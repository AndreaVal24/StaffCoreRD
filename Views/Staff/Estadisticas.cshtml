@model IEnumerable<DepartamentoEstadisticaViewModel>

@{
    ViewData["Title"] = "Estadísticas por Departamento";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-4">Estadísticas de Personal por Departamento</h2>
            <hr />
        </div>
    </div>

    <!-- Si no hay datos -->
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning" role="alert">
            No hay datos de empleados activos para mostrar estadísticas.
        </div>
    }
    else
    {
        <!-- CARDS POR DEPARTAMENTO -->
        <div class="row mb-5">
            @foreach (var dept in Model)
            {
                <!-- Determinar color según departamento -->
                
                    string cardBorderClass = dept.Departamento switch
                    {
                        "Tecnología" => "border-info",
                        "Recursos Humanos" => "border-success",
                        "Finanzas" => "border-warning",
                        "Operaciones" => "border-secondary",
                        _ => "border-dark"
                    };

                    string badgeClass = dept.Departamento switch
                    {
                        "Tecnología" => "bg-info",
                        "Recursos Humanos" => "bg-success",
                        "Finanzas" => "bg-warning",
                        "Operaciones" => "bg-secondary",
                        _ => "bg-dark"
                    };
                

                <div class="col-md-6 col-lg-3 mb-4">
                    <div class="card border-3 @cardBorderClass shadow">
                        <div class="card-header @badgeClass text-white">
                            <h5 class="mb-0">@dept.Departamento</h5>
                        </div>
                        <div class="card-body">
                            <!-- Total de empleados -->
                            <div class="mb-3">
                                <span class="text-muted">Empleados:</span>
                                <h4 class="text-primary">@dept.TotalEmpleados</h4>
                            </div>

                            <!-- Total de nómina -->
                            <div class="mb-3">
                                <span class="text-muted">Total Nómina:</span>
                                <h5 class="text-success">@dept.TotalNomina.ToString("C")</h5>
                            </div>

                            <!-- Salario promedio -->
                            <div>
                                <span class="text-muted">Salario Promedio:</span>
                                <h6 class="text-secondary">@dept.SalarioPromedio.ToString("C")</h6>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- TABLA RESUMEN DETALLADA -->
        <div class="row">
            <div class="col-12">
                <h4 class="mt-5 mb-3">Tabla Resumen</h4>
                <div class="table-responsive">
                    <table class="table table-striped table-hover table-bordered">
                        <thead class="table-dark">
                            <tr>
                                <th>Departamento</th>
                                <th>Total Empleados</th>
                                <th>Total Nómina</th>
                                <th>Salario Promedio</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dept in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@dept.Departamento</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary">@dept.TotalEmpleados</span>
                                    </td>
                                    <td>
                                        <strong class="text-success">@dept.TotalNomina.ToString("C")</strong>
                                    </td>
                                    <td>
                                        @dept.SalarioPromedio.ToString("C")
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td><strong>TOTAL GENERAL</strong></td>
                                <td>
                                    <strong class="badge bg-primary">
                                        @{
                                            int totalEmpleados = Model.Sum(m => m.TotalEmpleados);
                                        }
                                        @totalEmpleados
                                    </strong>
                                </td>
                                <td>
                                    <strong class="text-success">
                                        @{
                                            decimal totalNomina = Model.Sum(m => m.TotalNomina);
                                        }
                                        @totalNomina.ToString("C")
                                    </strong>
                                </td>
                                <td>
                                    @{
                                        decimal promedioGeneral = Model.Average(m => m.SalarioPromedio);
                                    }
                                    <strong>@promedioGeneral.ToString("C")</strong>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- INSIGHTS (datos interesantes) -->
        <div class="row mt-5">
            <div class="col-12">
                <h4 class="mb-3">Insights</h4>
                @{
                    var totalDepts = Model.Count();
                    
                    var maxEmpleados = Model.Max(m => m.TotalEmpleados);
                    var deptsMasEmpleados = Model.Where(m => m.TotalEmpleados == maxEmpleados).ToList();
                    
                    var maxNomina = Model.Max(m => m.TotalNomina);
                    var deptsMasNomina = Model.Where(m => m.TotalNomina == maxNomina).ToList();
                    
                    var maxSalarioPromedio = Model.Max(m => m.SalarioPromedio);
                    var deptsMayorSalarioPromedio = Model.Where(m => m.SalarioPromedio == maxSalarioPromedio).ToList();
                }

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <div class="alert alert-info">
                            <strong>Más Empleados:</strong><br />
                            @if (deptsMasEmpleados.Count == totalDepts && totalDepts > 1)
                            {
                                <span>Todos tienen la misma cantidad (@maxEmpleados empleados)</span>
                            }
                            else if (deptsMasEmpleados.Count > 1)
                            {
                                <span>Empate: @string.Join(", ", deptsMasEmpleados.Select(d => d.Departamento)) (@maxEmpleados empleados)</span>
                            }
                            else
                            {
                                <span>@deptsMasEmpleados.First().Departamento (@maxEmpleados empleados)</span>
                            }
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="alert alert-success">
                            <strong>Mayor Inversión en Nómina:</strong><br />
                            @if (deptsMasNomina.Count == totalDepts && totalDepts > 1)
                            {
                                <span>Todos tienen igual nómina (@maxNomina.ToString("C"))</span>
                            }
                            else if (deptsMasNomina.Count > 1)
                            {
                                <span>Empate: @string.Join(", ", deptsMasNomina.Select(d => d.Departamento)) (@maxNomina.ToString("C"))</span>
                            }
                            else
                            {
                                <span>@deptsMasNomina.First().Departamento (@maxNomina.ToString("C"))</span>
                            }
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="alert alert-warning">
                            <strong>Mayor Salario Promedio:</strong><br />
                            @if (deptsMayorSalarioPromedio.Count == totalDepts && totalDepts > 1)
                            {
                                <span>Promedios iguales en todos (@maxSalarioPromedio.ToString("C"))</span>
                            }
                            else if (deptsMayorSalarioPromedio.Count > 1)
                            {
                                <span>Empate: @string.Join(", ", deptsMayorSalarioPromedio.Select(d => d.Departamento)) (@maxSalarioPromedio.ToString("C"))</span>
                            }
                            else
                            {
                                <span>@deptsMayorSalarioPromedio.First().Departamento (@maxSalarioPromedio.ToString("C"))</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Botón para volver -->
    <div class="mt-4">
        <a asp-action="Index" class="btn btn-secondary">
            ← Volver a Personal
        </a>
    </div>
</div>