@model StaffCoreRD.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h2 class="card-title mb-4">Iniciar Sesión</h2>

                    <!-- asp-validation-summary="ModelOnly": Muestra errores del servidor -->
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <!-- Formulario que hace POST a AccountController/Login -->
                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Correo Electrónico</label>
                            <!-- asp-for vincula a la propiedad Email del LoginViewModel -->
                            <input type="email" class="form-control" asp-for="Email" />
                            <!-- Muestra errores específicos de validación de este campo -->
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Contraseña</label>
                            <!-- asp-for vincula a la propiedad Password del LoginViewModel -->
                            <input type="password" class="form-control" asp-for="Password" />
                            <!-- Muestra errores específicos de validación de este campo -->
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <!-- Botón que hace POST -->
                        <button type="submit" class="btn btn-primary w-100">Ingresar</button>
                    </form>

                    <!-- Link a registro -->
                    <div class="mt-3 text-center">
                        <p>¿No tienes cuenta? <a asp-action="Register">Registrate aquí</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Scripts de validación -->
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}