@model StaffCoreRD.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Crear Cuenta";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h2 class="card-title mb-4">Crear Nueva Cuenta</h2>

                    <!-- asp-validation-summary="ModelOnly": Muestra errores del servidor -->
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <!-- Formulario que hace POST a AccountController/Register -->
                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Correo Electrónico</label>
                            <!-- asp-for vincula a la propiedad Email del RegisterViewModel -->
                            <input type="email" class="form-control" asp-for="Email" />
                            <!-- Muestra errores específicos de validación de este campo -->
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Contraseña</label>
                            <!-- asp-for vincula a la propiedad Password del RegisterViewModel -->
                            <input type="password" class="form-control" asp-for="Password" />
                            <!-- Muestra errores específicos de validación de este campo -->
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PasswordConfirm" class="form-label">Confirmar Contraseña</label>
                            <!-- asp-for vincula a la propiedad PasswordConfirm del RegisterViewModel -->
                            <input type="password" class="form-control" asp-for="PasswordConfirm" />
                            <!-- Muestra errores específicos de validación (incluye [Compare] con Password) -->
                            <span asp-validation-for="PasswordConfirm" class="text-danger"></span>
                        </div>

                        <!-- Botón que hace POST a AccountController/Register -->
                        <button type="submit" class="btn btn-success w-100">Registrarse</button>
                    </form>

                    <!-- Link a login para usuarios que ya tienen cuenta -->
                    <div class="mt-3 text-center">
                        <p>¿Ya tienes cuenta? <a asp-action="Login">Inicia sesión aquí</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Scripts de validación -->
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}